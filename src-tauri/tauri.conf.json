{
  "build": {
    "beforeDevCommand": "npm run dashboard",
    "beforeBuildCommand": "npm --prefix dashboard run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dashboard/.next",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Agent Builder",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.agent.builder",
      "icon": []
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src *"
    },
    "windows": [
      {
        "title": "Agent Builder Mission Control",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
