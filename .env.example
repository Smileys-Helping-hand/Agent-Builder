ECONOMY_ENABLED=true
AUTO_LEARN=true

# --- Second-Brain knowledge sync ----------------------------------------------
# Research documents are pushed to Second-Brain's POST /api/ecosystem/knowledge
# and become recallable by its assistant. Second-Brain and this dashboard both
# default to port 3000, so run Second-Brain elsewhere (e.g. PORT=3100) when both
# are on the same machine.
SECOND_BRAIN_HOST=http://localhost:3100
# Falls back to JARVIS_API_KEY. The key needs the ingest_events permission.
SECOND_BRAIN_API_KEY=
SECOND_BRAIN_SYNC=true

# --- Continuous research ------------------------------------------------------
# Delay between cycles while a topic is still producing new findings.
RESEARCH_CYCLE_DELAY_MS=60000
# Cap on the backoff once a topic goes quiet. Research never stops on its own.
RESEARCH_MAX_BACKOFF_MS=1800000
KNOWLEDGE_DB_PATH=./data/knowledge.db

# ── Jarvis ───────────────────────────────────────────────────────────────────
# Where the builder reports builds, repairs and issues. Either give the whole
# webhook URL, or the host and key and it is assembled for you.
JARVIS_HOST=https://jarvis.savestate.co.za
JARVIS_API_KEY=
JARVIS_OWNER_ID=
# JARVIS_WEBHOOK_URL=https://jarvis.savestate.co.za/api/assistant/webhook/<key>

# ── Customer orders ──────────────────────────────────────────────────────────
# The site orders are pulled from. The builder polls it, so nothing needs to be
# able to reach this machine from outside.
SITE_URL=https://arpcloudsolutions.co.za
SITE_API_KEY=
# Start accepted orders without being asked. "false" makes every build manual.
ORDER_AUTO_START=true
# Keep improving delivered products. This is the point of the pipeline; turning
# it off means a delivered site stays exactly as it shipped.
ORDER_AUTO_IMPROVE=true
# One GPU, so one build at a time unless you know you have room for more.
ORDER_MAX_CONCURRENT_BUILDS=1
