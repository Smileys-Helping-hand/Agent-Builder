{
  "name": "agent-builder",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:server": "tsx src/server/server.ts",
    "dev:all": "concurrently \"npm run dev:server\" \"npm --prefix dashboard run dev\"",
    "dev:foreground": "concurrently -k -n \"API,Dashboard\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm --prefix dashboard run dev\"",
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc && node esbuild.config.js",
    "build:dashboard": "npm --prefix dashboard run build",
    "bundle": "node scripts/bundle.mjs",
    "package:win": "npm run bundle && node scripts/package/win.mjs",
    "package:mac": "npm run bundle && node scripts/package/mac.mjs",
    "package:linux": "npm run bundle && node scripts/package/linux.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "package": "npm run tauri:build",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "dashboard": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "verify": "npm run build",
    "build-studio": "tsx src/cli/buildStudio.ts",
    "build-studio:start": "tsx src/cli/buildStudio.ts start",
    "build-studio:list": "tsx src/cli/buildStudio.ts list",
    "build-studio:test": "tsx src/cli/testBuildStudio.ts",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "test:research": "tsx scripts/research-smoketest.ts",
    "test:orders-log": "tsx scripts/orders-log-smoketest.ts",
    "test:research-edit": "tsx scripts/research-edit-smoketest.ts",
    "test:game-mode": "tsx scripts/game-mode-smoketest.ts",
    "test:builder-guards": "tsx scripts/builder-guards-smoketest.ts",
    "test:art": "tsx scripts/art-library-smoketest.ts",
    "test:research-chat": "tsx scripts/research-chat-smoketest.ts",
    "test:exemplars": "tsx scripts/exemplar-memory-smoketest.ts",
    "key:agent": "tsx scripts/mint-agent-key.ts",
    "ecosystem:scan": "tsx scripts/scan-ecosystem.ts",
    "verify:templates": "tsx scripts/verify-templates.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.52.1",
    "@opentelemetry/resources": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@opentelemetry/semantic-conventions": "^1.21.0",
    "@types/qrcode": "^1.5.6",
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "chokidar": "^3.6.0",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "diff": "^5.2.0",
    "dotenv": "^16.3.1",
    "edge-tts": "^1.0.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nats": "^2.18.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.5.0",
    "pg": "^8.11.5",
    "pgvector": "^0.2.0",
    "qrcode": "^1.5.4",
    "redis": "^4.6.13",
    "roblox-ts": "^2.1.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^9.0.0",
    "ws": "^8.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@rbxts/types": "^1.0.890",
    "@tauri-apps/cli": "^1.5.9",
    "@types/amqplib": "^0.10.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/chokidar": "^2.1.7",
    "@types/cors": "^2.8.19",
    "@types/diff": "^5.0.9",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.22.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.21.5",
    "ts-node": "^10.9.1",
    "tsx": "^4.15.7",
    "typescript": "^5.6.3"
  }
}
